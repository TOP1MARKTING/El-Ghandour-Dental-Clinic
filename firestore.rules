rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    // حساب الدكتور
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() == 'admin@elghandour.com';
    }

    // أي حساب متعمل في Firebase Authentication — الحسابات بيعملها صاحب المشروع من الـ Console بس
    function canAccess() {
      return signedIn();
    }

    function noDiscountOrAdmin() {
      return !('discountPercent' in request.resource.data)
        || request.resource.data.discountPercent == 0
        || isAdmin();
    }

    // إعدادات العيادة: الكل يقرا (سعر الكشف والخصومات)، والأدمن بس يعدّل
    match /settings/{settingId} {
      allow get: if canAccess();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // حذف المريض بيمسح فلوسه، فللأدمن بس
    match /patients/{patientId} {
      allow get, list, create, update: if canAccess();
      allow delete: if isAdmin();
    }

    // الزيارات والدفعات القديمة ما تتغيرش — الأدمن بس يقدر يصلّح
    match /visits/{visitId} {
      allow get, list: if canAccess();
      allow create: if canAccess() && noDiscountOrAdmin();
      allow update, delete: if isAdmin();
    }

    // الاستقبال بيسجل الدفع ويشوف دفعات المريض في ملفه، والخزنة في الواجهة للأدمن بس
    match /payments/{paymentId} {
      allow get, list, create: if canAccess();
      allow update, delete: if isAdmin();
    }

    // مواعيد المتابعة للاستقبال والدكتور
    match /appointments/{appointmentId} {
      allow get, list, create, update: if canAccess();
      allow delete: if isAdmin();
    }

    match /queue/{queueId} {
      allow get, list, create, update, delete: if canAccess();
    }

    // أسعار الخدمات: الكل يقرا عشان الحساب، الأدمن بس يعدّل
    match /services/{serviceId} {
      allow get, list: if canAccess();
      allow create, update, delete: if isAdmin();
    }

    // المصروفات للأدمن بس
    match /expenses/{expenseId} {
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}
